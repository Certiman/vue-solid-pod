@prefix dash:    <http://datashapes.org/dash#> .
@prefix era:     <http://data.europa.eu/949/> .      
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:  <http://schema.org/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix vpa:     <http://w3id.org/vpa/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix iss:     <http://data.europa.eu/949/iss/> . 

# Non-resolving URIs
@prefix issform: <http://data.europa.eu/949/forms/iss/> .
@prefix update:  <http://data.europa.eu/949/app/updates/> .

# SKOS
@prefix iss-skos: <https://raw.githubusercontent.com/Interoperable-data/ISS_vocabulary/refs/heads/main/iss-skos/> .
@prefix iss-rs: <http://data.europa.eu/949/iss/concepts/record-statuses/> .

@prefix era-va-authcase: <http://data.europa.eu/949/concepts/va-authcases/> .
@prefix era-organisation-roles: <http://data.europa.eu/949/concepts/organisation-roles/> .

era:VTAAShape a sh:NodeShape ;
  sh:targetClass era:VehicleTypeAuthorisationApplication ; # vpa:Request ;
  sh:property [
    sh:name "Application ID" ;
    sh:path dcterms:identifier ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1
  ];
  sh:property [
    sh:name "OSS Application ID" ;
    sh:description "Only fill in when the application also exists in OSS" ;
    # sh:group issform:GI ;
    sh:path rdfs:seeAlso ;
    sh:datatype xsd:string ;
    sh:pattern "^V-20\\d{2}[01-12][0-3][1-9]-\\d{3}$" ;
    sh:maxCount 1
  ];
  sh:property [
    # rdfs:label “{{Project Name}}”@de ; # Project Name, in German.
    sh:path rdfs:label ;
    sh:name "Project Name"@en ;
    sh:description "Project Name"@en ;
    # sh:group issform:GI ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" "fr" "de" "es" ) ;
    sh:uniqueLang "true"^^xsd:boolean ;
    sh:maxCount 1 ;
    sh:minLength 6 ;
    sh:minCount 1
  ];
  sh:property [
    # rdfs:comment “{{Other relevant Information}}”@en ;
    sh:name "Other relevant Information"@en ;
    # sh:group issform:GI ;
    sh:description "Other relevant Information"@en ;
    sh:path rdfs:comment ;
    dash:singleLine false ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" "fr" "de" "es" ) ;
    sh:uniqueLang "true"^^xsd:boolean ;
    sh:maxCount 1 ;
    sh:minCount 1
  ];
  sh:property [
    # PreEngagement is a choice
    sh:name "Pre-Engagement" ;
    sh:path era:hasPreEngagement ;
    # sh:group issform:GI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:node era:PreEngagementShape ; 
        sh:name "Yes, pre-engagement baseline" ]
      [ sh:node era:noPreEngagementShape  ; 
        sh:name "No pre-engagement baseline" ]
    )
  ];
  sh:property [
    sh:node era:VTACShape ;
    sh:name "Authorisation Case";
    sh:path vpa:constitutedBy ;
    sh:minCount 1 ;
    sh:maxCount 8
  ];
  sh:property [
    # dcterms:creator [ a era:OrganisationRole ; era:roleOf <URI of Applicant> ] ;
    sh:node era:ApplicantOrgRoleShape ;
    # sh:group issform:APP ;
    sh:path dcterms:creator ;
    sh:name "Applicant's Information" ;
    sh:maxCount 1 ;
    sh:minCount 1
  ] .

era:VTACShape a sh:NodeShape ;
   sh:targetClass era:VehicleTypeAuthorisationCase ; ;
   sh:property [
     sh:name "Authorisation Case Type" ;
     sh:path vpa:permissionType ;
     sh:nodeKind sh:IRI ;
     sh:hasValue era-va-authcase:C2T ;
     sh:minCount 1 ;
     sh:maxCount 1
   ];
   sh:property [
     sh:path vpa:concerns ;  # allowed ONLY once
     # Leads to class conformin to both?
     sh:node [ sh:and ( era:VTShape  era:VehicleNumberScopeShape ) ]; 
     sh:minCount 1 ;
     sh:maxCount 1 
   ]. 

# The Scope can be one VehicleTypeScopeShape per case
era:VTShape a sh:NodeShape ;
  # sh:targetClass era:VehicleType ;
  sh:targetClass vpa:Scope;
  sh:property [
    sh:path dcterms:identifier ;
    sh:name "VehicleType Identifier"@en ;
    # OK sh:pattern "^\\d{2}-\\d{3}-\\d{4}-\\d-(\\d{3}(-\\d{3})?)$" ;
    sh:description "NN-MMM-LLLL-N-VAR(-VER)" ;
    # OK sh:hasValue "12-789-1324-4-007-009" ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    # OK sh:minLength 17 ;
    sh:maxLength 21 ;
    sh:maxCount 1
  ].

# The Scope can be one or more Vehicle Numbers per case
era:VehicleNumberScopeShape a sh:NodeShape ;
  # sh:targetClass era:VehicleSet ;
  sh:targetClass vpa:Scope;
  sh:property [
    sh:name "Vehicle Identifier"@en ;
    sh:path rdfs:member ;
    sh:datatype xsd:string ;
    # OK sh:hasValue "132165498-9" ;
    sh:minCount 1 ;
    # TODO: sh:pattern See VAI
  ];
  sh:property [
  # The datatype update: is caught by the form post processor
   sh:name "Pre-reserved Numbers" ;
   sh:path update:arePreReservedNumbers ;
   sh:datatype xsd:boolean ;
   sh:minCount 1 ;   
   sh:maxCount 1 ;
].

# The Applicant must be identified with its OrgCode, it MUST be converted into a URI.
era:ApplicantOrgRoleShape a sh:NodeShape ;
  sh:targetClass era:OrganisationRole ;
  sh:property [
     # For conversion to an org URI
    sh:path era:roleOf ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:name "Confirm applicant" ;
    sh:or (
       [ sh:node era:ApplicantByNamShape ; 
         sh:name "By Name" ]
       [ 
         sh:node era:ApplicantByCodeShape ; 
         sh:name "By Code" ]
    )
  ];
  sh:property [
    sh:path era:hasOrganisationRole ;
    sh:hasValue era-organisation-roles:Applicant ;
    sh:nodeKind sh:IRI ;
    sh:name "Applicant Role" ;
    sh:maxCount 1 ;
  ].

# Id By Name
era:ApplicantByNamShape a sh:NodeShape ;
  sh:targetClass era:Body ;
  sh:property [
    sh:path era:roleOf ;
    sh:name "Applicant Name" ;
    sh:description "Name of the Applicant" ;
    sh:datatype xsd:string ;
    sh:maxCount 1
  ].

# Id by orgCode
era:ApplicantByCodeShape a sh:NodeShape ;
  sh:targetClass era:Body;
  sh:property [
    sh:path era:orgCode ;
    sh:pattern "^\\w{4}$" ; # K3L8 eg.
    sh:description "Confirm your OrgCode as Applicant" ;
    sh:name "Organisation Code" ;
    sh:maxCount 1
  ].

# If PreEngagement, a Reference to pre-engagement baseline is required
era:PreEngagementShape a sh:NodeShape ;
  sh:targetClass era:PreEngagement ;
  # sh:property [
  #   # era:preEngagementBaseline era:Document
  #   sh:path era:preEngagementBaseline ;
  #   sh:name "Pre-engagement baseline present"@en ;
  #   sh:datatype xsd:boolean;
  #   sh:hasValue "true"^^xsd:boolean;
  #   sh:nodeKind sh:Literal ;
  #   sh:minCount 1 ;
  #   sh:maxCount 1
  # ];
  sh:property [
    # era:preEngagementBaseline era:Document
    sh:path era:preEngagementBaselineDocument ;
    sh:name "PreEngagement Reference"@en ;
    sh:datatype xsd:string;
    sh:minCount 1
  ] .

# # If NO PreEngagement, only boolean as already marked
era:noPreEngagementShape a sh:NodeShape ;
  sh:targetClass era:PreEngagement ;
  sh:property [
    # era:preEngagementBaseline era:Document
    sh:path era:preEngagementBaseline ;
    sh:name "Pre-engagement baseline present"@en ;
    sh:datatype xsd:boolean;
    sh:nodeKind sh:Literal ;
    sh:hasValue "false"^^xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] .