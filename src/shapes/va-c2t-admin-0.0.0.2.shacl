@prefix dash:    <http://datashapes.org/dash#> .
@prefix era:     <http://data.europa.eu/949/> .      
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:  <http://schema.org/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix unit:    <http://qudt.org/vocab/unit/> .
@prefix vpa:     <http://w3id.org/vpa/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix iss:     <http://data.europa.eu/949/iss/> . 

# Non-resolving URIs
@prefix issform: <http://data.europa.eu/949/forms/iss/> .
@prefix update:  <http://data.europa.eu/949/app/updates/> .

# SKOS
@prefix iss-skos: <https://raw.githubusercontent.com/Interoperable-data/ISS_vocabulary/refs/heads/main/iss-skos/> .
@prefix iss-rs: <http://data.europa.eu/949/iss/concepts/record-statuses/> .

@prefix era-va-authcase: <http://data.europa.eu/949/concepts/va-authcases/> .
@prefix era-organisation-roles: <http://data.europa.eu/949/concepts/organisation-roles/> .

era:VTAAShape a sh:NodeShape ;
  sh:targetClass era:VTAApp ;
  sh:property [
    sh:name "Application ID" ;
    sh:path dcterms:identifier ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1
  ];
  sh:property [
    sh:node era:VTACShape ;
    sh:name "Authorisation Case";
    sh:path vpa:constitutedBy ;
    sh:minCount 1 ;
    sh:maxCount 3
  ].

era:VTACShape a sh:NodeShape ;
   sh:targetClass era:VTACase ;
   sh:property [
     sh:name "Authorisation Case" ;
     sh:path vpa:permissionType ;
     sh:nodeKind sh:IRI ;
     sh:hasValue era-va-authcase:C2T ;
     sh:minCount 1 ;
     sh:maxCount 1
   ];
   sh:property [
     sh:path vpa:concerns ;  # allowed ONLY once
     sh:name "Vehicle Type" ;
     sh:node era:VTShape ;
     # NOK sh:nodeKind sh:blankNode ;
     sh:minCount 1 ;
     sh:maxCount 1 # BLOCKS vpa:concerns below
   ];
   sh:property [
     sh:path vpa:concerns2 ;
     # sh:path vpa:concerns ; BLOCKS multiple VTAC nodes!
     sh:name "Vehilce Numbers" ;
     sh:shape era:VehicleNumberScopeShape ;
     sh:minCount 1
   ]. 

# The Scope can be one VehicleTypeScopeShape per case
era:VTShape a sh:NodeShape ;
  sh:targetClass era:VehicleType ;
  sh:property [
    sh:path dcterms:identifier ;
    sh:name "VehicleType Identifier"@en ;
    # sh:pattern "^\\d{2}-\\d{3}-\\d{4}-\\d-(\\d{3}(-\\d{3})?)$" ;
    sh:description "NN-MMM-LLLL-N-VAR(-VER)" ;
    # OK sh:hasValue "12-789-1324-4-007-009" ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    # OKsh:minLength 17 ;
    sh:maxLength 21 ;
    sh:maxCount 1
  ].

# The Scope can be one or more Vehicle Numbers per case
era:VehicleNumberScopeShape a sh:NodeShape ;
  sh:targetClass era:VehicleSet ;
  sh:property [
    sh:name "Vehicle Identifier"@en ;
    sh:path rdfs:member ;
    sh:datatype xsd:string ;
    sh:hasValue "132165498-9" ;
    sh:minCount 1 ;
    # sh:pattern See VAI
  ];
  sh:property [
  # The datatype update: is caught by the form post processor
   sh:name "Pre-reserved Numbers" ;
   sh:path update:arePreReservedNumbers ;
   sh:datatype xsd:boolean ;
   sh:minCount 1 ;   
   sh:maxCount 1 ;
].

